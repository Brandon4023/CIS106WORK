def display_names(names_array):
    print("\n--- Last Names ---")
    length = 0 
    for _ in names_array:
        length+= 1
        
    i = 0
    while i < length:
        print(f"Index {i}: {names_array[i]}")
        i += 1


def display_names_reverse(names_array):
    print("\n--- Last Names in Reverse Order ---")
    length = 0
    for _ in names_array:
        length += 1

    i = length - 1
    while i >= 0:
        print(f"Index {i}: {names_array[i]}")
        i -= 1


# Assigning 10 last names to a list
def main():
    last_names = []
    file_name = "LastNames.txt"

    # Read last names from the file
    try:
        with open(file_name, "r") as file:
            for line in file:
                last_names.append(line.strip())
    except FileNotFoundError:
        print(f"File {file_name} not found.")

    # Custom functions to display the last names in order and in reverse order
    display_names(last_names)
    display_names_reverse(last_names)


if __name__ == "__main__":
    main()