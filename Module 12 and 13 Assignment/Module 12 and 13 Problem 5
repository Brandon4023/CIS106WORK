def calculate_student_grade_averages(grades_dict):
    """Return a dictionary of each student's average grade."""
    student_averages = {}
  
    for name, grades in grades_dict.items():
        total = 0.0
        count = 0
        for grade in grades:
            total += grade
            count += 1
            
        student_averages[name] = total / count if count > 0 else 0.0

    return student_averages


def calculate_class_exam_average(grades_dict):
    """Return the average score for each exam across all students."""
    if not grades_dict:
        return [0.0, 0.0, 0.0]

    student_count = 0
    for _ in grades_dict:
        student_count += 1

    exam_totals = [0.0, 0.0, 0.0]

    for grades in grades_dict.values():
        for index in range(3):
            exam_totals[index] += grades[index]

    exam_averages = [
        exam_totals[0] / student_count,
        exam_totals[1] / student_count,
        exam_totals[2] / student_count,
    ]

    return exam_averages


def display_report(grades_dict, student_averages, exam_averages):
    """Display a report card for all students and class averages."""
    print("\n" + "=" * 62)
    print(" STUDENT ACADEMIC REPORT CARD ".center(62, "="))
    print(f"{'Student Name':<15}{'Exam 1':<10}{'Exam 2':<10}{'Exam 3':<10}{'Average':<10}")
    print("-" * 62)

    for name, grades in grades_dict.items():
        average = student_averages[name]
        print(f"{name:<15} {grades[0]:<10.1f} {grades[1]:<10.1f} {grades[2]:<10.1f} {average:<10.2f}")

    print(f"{'Class Average':<15} {exam_averages[0]:<10.2f} {exam_averages[1]:<10.2f} {exam_averages[2]:<10.2f}")
    
    overall_total = exam_averages[0] + exam_averages[1] + exam_averages[2]
    overall_average = overall_total / 3.0
    print(f"\nOverall Class Average Across All Exams: {overall_average:.2f}")
    print("=" * 62)

#Dictionary with student names and with the 3 grades as thier values
def main():
    grades_dict = {
        "Larsen": [90, 85, 92],
        "Bob": [78, 88, 80],
        "Charlie": [95, 91, 89],
    }
    #Calculates student averages
    student_averages = calculate_student_grade_averages(grades_dict)
    #Calculates class averages
    exam_averages = calculate_class_exam_average(grades_dict)
    #This will display the report of the grades and the averages
    display_report(grades_dict, student_averages, exam_averages)


if __name__ == "__main__":
    main()
