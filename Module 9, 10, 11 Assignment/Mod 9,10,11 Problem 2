# Player Batting Average 

def compute_batting_average(hits, at_bats):
    """Computes and returns batting average given hits and at bats."""
    if at_bats == 0:
        return 0.0
    return hits / at_bats

def main():
    player_count = 0

    user_response = input("Do you want to enter a player? (Yes/No): ").strip().lower()

    while user_response in ["yes", "y"]:
        last_name = input("Enter player's last name: ").strip()
        hits = int(input("Enter number of hits: "))
        at_bats = int(input("Enter number of at-bats: "))

        # Call function to compute batting average
        batting_average = compute_batting_average(hits, at_bats)
        
        # Total player count

        player_count += 1

        # Display player summary results
        print(f"Player: {last_name}")
        print(f"Batting Average: {batting_average:.3f}")
        print("-" * 35)
        user_response = input("Do you want to enter another player? (Yes/No): ").strip().lower()

    # Final output
    print("\n" + "=" * 35)
    print(f"Total number of players entered: {player_count}")
    print("Program has ended.")


if __name__ == "__main__":
    main()