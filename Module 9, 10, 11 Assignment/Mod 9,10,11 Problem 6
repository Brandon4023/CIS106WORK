# Student Exam Score and Averages

def calculate_scores(score1, score2, score3):
    total = score1 + score2 + score3
    average = total / 3
    return total, average

#Get user input for student name and exam scores
last_name = input("Enter student's last name: ")
score1 = float(input("Enter score for Exam 1: "))
score2 = float(input("Enter score for Exam 2: "))
score3 = float(input("Enter score for Exam 3: "))

# Call function to calculate total and average scores
total, average = calculate_scores(score1, score2, score3)

# Display results
print("\nStudent:", last_name)
print("Total Points:", total)
print("Average Exam Score:", format(average, ".2f"))