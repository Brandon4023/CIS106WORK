total_tuition = 0.0
student_count = 0

print(f"{'Student Name':<15}{'Credits':<10}{'Tuition Owed':<15}")
print("-" * 40)

with open("students.txt", 'r') as file:
    lines = [line.strip() for line in file if line.strip()]

    for i in range(0, len(lines), 3):
        last_name = lines[i]
        district_code = lines[i + 1].upper()
        credits = int(lines[i + 2])

        if district_code == "I":
            tuition_rate = 250.00
        else:
            tuition_rate = 500.00
        
        tuition = credits * tuition_rate

        total_tuition += tuition
        student_count += 1

        print(f"{last_name:<15}{credits:<10}{tuition:<15,.2f}")

        print("-" * 40)
        print(f"Total Students Processed: {student_count}")
        print(f"Total Tuition Owed: ${total_tuition:.2f}")