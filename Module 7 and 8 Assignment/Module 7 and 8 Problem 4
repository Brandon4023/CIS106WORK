file_name = "items.txt"

total_extended_price = 0.0
order_count = 0 

print(f"{'Item':<12}{'Quantity':<10}{'Price':<12}{'Extended Price':<15}")
print("-" * 50)

with open(file_name, 'r') as file:
    lines = [line.strip() for line in file if line.strip()]

    for i in range(0, len(lines), 3):
        item = lines[i]
        quantity = int(lines[i + 1])
        price = float(lines[i + 2])

        extended_price = quantity * price
        total_extended_price += extended_price
        order_count += 1

        print(f"{item:<12}{quantity:<10}{price:<12,.2f}{extended_price:<15,.2f}")

        average_order = total_extended_price / order_count if order_count > 0 else 0.0

        print("-" * 50)
        print(f"Total extended price: ${total_extended_price:.2f}")
        print(f"Number of orders: {order_count}")
        print(f"Average order: ${average_order:.2f}")